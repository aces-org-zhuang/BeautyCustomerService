# Copy to .env for local development if the project later defines runtime variables.
# Do not store real secrets in this file.

# Local runtime
# PORT=8787
# BCS_DATA_FILE=data/local-mvp-store.json

# Real RAGFlow retrieval/sync. Required for real knowledge answers.
# RAGFlow is enabled by default when API key and dataset are configured.
# Set BCS_USE_RAGFLOW=0 to force-disable real RAGFlow retrieval.
# BCS_USE_RAGFLOW=0
# BCS_AUTO_ANSWER_CONFIDENCE=0.3
# RAGFLOW_BASE_URL=http://127.0.0.1:9380
# RAGFLOW_API_KEY=
# RAGFLOW_DATASET_IDS=dataset_id_1,dataset_id_2
# RAGFLOW_DATASET_NAMES=beauty-faq
# RAGFLOW_STAGING_DATASET_NAME=beauty-material-staging
# RAGFLOW_STAGING_CHUNK_METHOD=naive
# RAGFLOW_STAGING_CHUNK_TOKEN_NUM=128
# RAGFLOW_STAGING_DELIMITER=\n.!?;。；！？

# Explicit demo-only local knowledge. Keep disabled unless you want local fixtures.
# BCS_ENABLE_LOCAL_TEST_KNOWLEDGE=1

# Explicit demo-only local publish/fallback. Keep disabled for production-like flows.
# BCS_ENABLE_DEMO_PUBLISHED_KNOWLEDGE=1

# Real llm_wiki API. Required for llm_wiki -> RAGFlow sync.
# LLM_WIKI_API_BASE_URL=http://127.0.0.1:19828
# LLM_WIKI_API_TOKEN=
# LLM_WIKI_CANDIDATE_PATH=wiki/queries/xiaoqipao-oily-skin.md

# Real WeChat Customer Service callback demo.
# Keep disabled unless the callback URL, Token and EncodingAESKey are configured in WeChat KF admin.
# WECHAT_KF_ENABLED=0
# WECHAT_KF_SEND_ENABLED=0
# WECHAT_CORP_ID=
# WECHAT_KF_SECRET=
# WECHAT_KF_CALLBACK_TOKEN=
# WECHAT_KF_ENCODING_AES_KEY=
# WECHAT_KF_CALLBACK_PATH=/api/wechat/kf/callback
# WECHAT_KF_API_BASE_URL=https://qyapi.weixin.qq.com
# WECHAT_KF_SYNC_LIMIT=100
# WECHAT_KF_ACCESS_TOKEN_CACHE_TTL_SECONDS=6600
